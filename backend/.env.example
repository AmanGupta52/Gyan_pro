NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/gyan26?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated; add your deployed web URL. The Capacitor app origins are needed for the APK.
CORS_ORIGIN=http://localhost:5173,https://localhost,http://localhost,capacitor://localhost
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# EmailJS (https://www.emailjs.com). Leave empty in development to just log emails to the console.
# Required when NODE_ENV=production.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_PRIVATE_KEY=your-private-key
EMAIL_FROM_NAME=GYAN-26
SEED_ADMIN_EMAIL=admin@gyan26.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
